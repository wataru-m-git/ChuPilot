# ───────────────────────────────────────────────────────────────
# このファイルは「テンプレート」です。
# コピーして .env.local を作成し、各値を設定してください:
#   cp .env.local.example .env.local
# .env.local は .gitignore で除外され、公開リポジトリには含まれません。
# ───────────────────────────────────────────────────────────────

# Auth.js v5
AUTH_URL=http://localhost:3333

# セッション(JWT)の署名・暗号化に使う秘密鍵。【必須・各自で生成】
# 次のコマンドで生成した文字列を貼り付けてください:
#   openssl rand -base64 32
# ※ 空のままだとログイン認証が正しく動作しません。
# ※ この値が漏れると、なりすましログインが可能になります。絶対に公開しないこと。
AUTH_SECRET=

# データベース（CWD=プロジェクトルート からの相対パス）
DATABASE_URL="file:./data/mouse_colony.db"

# 初期管理者アカウント設定（シードスクリプトで管理者を作成する場合に使用）
ADMIN_EMAIL=admin@local.lab
# 管理者の初期パスワード。【必須・各自で設定】
# 空の場合は「ChangeMe@123456」が使用されます。本番では必ず変更してください。
ADMIN_DEFAULT_PASSWORD=

# ユーザー登録制御（初回セットアップ後は false に設定）
ALLOW_SELF_REGISTRATION=false
